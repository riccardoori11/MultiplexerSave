# Bash completion for work. Can also be sourced directly from ~/.bashrc.
_work_project_names() (
    local config_dir path name LC_ALL=C
    [[ -n ${HOME:-} ]] || return 0
    if [[ -n ${WORK_CONFIG_HOME:-} ]]; then
        config_dir=$WORK_CONFIG_HOME
    elif [[ -n ${XDG_CONFIG_HOME:-} ]]; then
        [[ $XDG_CONFIG_HOME == /* ]] || return 0
        config_dir=$XDG_CONFIG_HOME/work
    else
        config_dir=$HOME/.config/work
    fi

    # Keep glob settings local to this subshell.
    unset GLOBIGNORE
    shopt -s nullglob
    shopt -u failglob dotglob nocaseglob
    for path in "$config_dir"/projects/*.work; do
        [[ -f $path ]] || continue
        name=${path##*/}
        name=${name%.work}
        [[ $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ ]] || continue
        printf '%s\n' "$name"
    done
)

_work() {
    local cur="${COMP_WORDS[COMP_CWORD]}" command="${COMP_WORDS[1]-}"
    local candidate word used i
    local has_project=0
    local -a candidates=() options=()
    COMPREPLY=()

    if (( COMP_CWORD == 1 )); then
        candidates=(init open save kill delete list config doctor help --help --version)
    else
        case "$command" in
            open|save|kill|delete|config)
                case "$command" in
                    open) options=(--no-attach --fresh) ;;
                    save) options=(--quiet) ;;
                esac
                for ((i = 2; i < COMP_CWORD; ++i)); do
                    word=${COMP_WORDS[i]}
                    case "$command:$word" in
                        open:--no-attach|open:--fresh|save:--quiet) ;;
                        *:-*) return 0 ;;
                        *)
                            (( has_project == 0 )) || return 0
                            has_project=1
                            ;;
                    esac
                done
                for candidate in "${options[@]}"; do
                    used=0
                    for ((i = 2; i < COMP_CWORD; ++i)); do
                        if [[ ${COMP_WORDS[i]} == "$candidate" ]]; then
                            used=1
                            break
                        fi
                    done
                    (( used )) || candidates+=("$candidate")
                done
                if (( has_project == 0 )) && [[ $cur != -* ]]; then
                    while IFS= read -r candidate; do
                        candidates+=("$candidate")
                    done < <(_work_project_names 2>/dev/null)
                fi
                ;;
            init)
                if (( COMP_CWORD == 3 )); then
                    candidates=(--root)
                elif (( COMP_CWORD == 4 )) && [[ ${COMP_WORDS[3]} == --root ]]; then
                    compopt -o dirnames 2>/dev/null
                    return 0
                fi
                ;;
        esac
    fi

    for candidate in "${candidates[@]}"; do
        if [[ $candidate == "$cur"* ]]; then COMPREPLY+=("$candidate"); fi
    done
    return 0
}
complete -F _work work
