# Bash completion for work. Can also be sourced directly from ~/.bashrc.
_work_project_names() (
    local config_dir path name LC_ALL=C
    [[ -n ${HOME:-} ]] || return 0
    if [[ -n ${WORK_CONFIG_HOME:-} ]]; then
        config_dir=$WORK_CONFIG_HOME
    elif [[ -n ${XDG_CONFIG_HOME:-} ]]; then
        [[ $XDG_CONFIG_HOME == /* ]] || return 0
        config_dir=$XDG_CONFIG_HOME/work
    else
        config_dir=$HOME/.config/work
    fi

    # Keep glob settings local to this subshell.
    unset GLOBIGNORE
    shopt -s nullglob
    shopt -u failglob dotglob nocaseglob
    for path in "$config_dir"/projects/*.work; do
        [[ -f $path ]] || continue
        name=${path##*/}
        name=${name%.work}
        [[ $name =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ ]] || continue
        printf '%s\n' "$name"
    done
)

_work_add_matches() {
    # Usage: _work_add_matches CUR WORD...; appends WORDs starting with CUR.
    local cur=$1 word
    shift
    for word in "$@"; do
        if [[ $word == "$cur"* ]]; then COMPREPLY+=("$word"); fi
    done
}

_work() {
    COMPREPLY=()
    local cur="${COMP_WORDS[COMP_CWORD]-}" command="${COMP_WORDS[1]-}"
    local word candidate i have_name=0 have_all=0
    local -a options=() unused=() names=()

    if (( COMP_CWORD == 1 )); then
        if [[ $cur == -* ]]; then
            _work_add_matches "$cur" --help --version
        else
            _work_add_matches "$cur" open save kill init delete list config help
        fi
        return 0
    fi

    case "$command" in
        open) options=(--no-attach --fresh) ;;
        save) options=(--quiet --all) ;;
        kill) ;;
        delete|config)
            # Exactly one project name.
            (( COMP_CWORD == 2 )) && [[ $cur != -* ]] || return 0
            while IFS= read -r candidate; do names+=("$candidate"); done \
                < <(_work_project_names 2>/dev/null)
            _work_add_matches "$cur" "${names[@]}"
            return 0
            ;;
        init)
            # work init NAME [--root DIRECTORY]; NAME is new, so nothing to suggest.
            if (( COMP_CWORD == 3 )); then
                _work_add_matches "$cur" --root
            elif (( COMP_CWORD == 4 )) && [[ ${COMP_WORDS[3]-} == --root ]]; then
                compopt -o filenames 2>/dev/null
                while IFS= read -r candidate; do COMPREPLY+=("$candidate"); done \
                    < <(compgen -d -- "$cur")
            fi
            return 0
            ;;
        *) return 0 ;;
    esac

    # open, save and kill: one optional project name plus their options, in any order.
    for ((i = 2; i < COMP_CWORD; ++i)); do
        word=${COMP_WORDS[i]}
        [[ $word == -* ]] || have_name=1
        [[ $word == --all ]] && have_all=1
    done
    for word in "${options[@]}"; do
        for ((i = 2; i < COMP_CWORD; ++i)); do
            [[ ${COMP_WORDS[i]} == "$word" ]] && continue 2
        done
        # --all replaces the project name, so it can't follow one.
        [[ $word == --all ]] && (( have_name )) && continue
        unused+=("$word")
    done

    if [[ $cur == -* ]] || (( have_name || have_all )); then
        _work_add_matches "$cur" "${unused[@]}"
    else
        while IFS= read -r candidate; do names+=("$candidate"); done \
            < <(_work_project_names 2>/dev/null)
        _work_add_matches "$cur" "${names[@]}"
    fi
    return 0
}
# Leave filename fallback disabled, including when no project matches.
complete -F _work work
